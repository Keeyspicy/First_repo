{
  "name": "LEAD_OUTREACH",
  "nodes": [
    {
      "parameters": {},
      "id": "lo-node-001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [200, 400]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "lo-asgn-001",
              "name": "niche",
              "value": "contractors",
              "type": "string"
            },
            {
              "id": "lo-asgn-002",
              "name": "location",
              "value": "Texas",
              "type": "string"
            },
            {
              "id": "lo-asgn-003",
              "name": "target_count",
              "value": 40,
              "type": "number"
            },
            {
              "id": "lo-asgn-004",
              "name": "daily_limit",
              "value": 10,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "lo-node-002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [420, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.airtable.com/v0/appCeu2l3qEcbMTsY/Leads",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $vars.AIRTABLE_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filterByFormula",
              "value": "AND({status}='Enriched',{email}!='')"
            },
            {
              "name": "maxRecords",
              "value": "10"
            }
          ]
        },
        "options": {}
      },
      "id": "lo-node-003",
      "name": "Fetch Enriched Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 400]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst records = response.records || [];\n\nif (records.length === 0) {\n  return [{ json: { message: 'No enriched leads ready for outreach', count: 0 } }];\n}\n\nreturn records.map(record => ({\n  json: {\n    recordId: record.id,\n    business_name: record.fields.business_name || '',\n    owner_name: record.fields.owner_name || '',\n    email: record.fields.email || '',\n    niche: record.fields.niche || 'contractors',\n    location: record.fields.location || 'Texas'\n  }\n}));"
      },
      "id": "lo-node-004",
      "name": "Parse Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 400]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst dailyLimit = $('Config').first().json.daily_limit || 10;\nconst limited = items.slice(0, dailyLimit);\n\nreturn limited.map(item => {\n  const ownerName = item.json.owner_name || 'there';\n  const businessName = item.json.business_name || 'your business';\n  const location = item.json.location || 'Texas';\n\n  const subject = `${businessName} — quick question`;\n  const body = `Hi ${ownerName},\\n\\nDo you need more qualified jobs for your contracting business in ${location}?\\n\\nWe help contractors get consistent, qualified leads. No long-term contracts, results-based.\\n\\nAre you open to a 10-minute call this week?\\n\\n[Your Name]\\n[Your Phone / Calendar Link]`;\n\n  return {\n    json: {\n      ...item.json,\n      subject,\n      body\n    }\n  };\n});"
      },
      "id": "lo-node-005",
      "name": "Build Email Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 400]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "lo-node-006",
      "name": "Loop Through Leads",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1300, 400]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "toList": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.body }}",
        "options": {}
      },
      "id": "lo-node-007",
      "name": "Send Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1520, 280],
      "credentials": {
        "gmailOAuth2": {
          "id": "CONFIGURE_IN_N8N",
          "name": "keeyspicy"
        }
      },
      "notes": "Set credentials to your Gmail OAuth2 account named 'keeyspicy' or 'Kristens Endijs' in n8n credentials manager."
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.airtable.com/v0/appCeu2l3qEcbMTsY/Leads/{{ $('Loop Through Leads').item.json.recordId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $vars.AIRTABLE_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ fields: { status: 'Contacted', outreach_sent_at: new Date().toISOString() } }) }}",
        "options": {}
      },
      "id": "lo-node-008",
      "name": "Mark as Contacted",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1740, 280]
    }
  ],
  "connections": {
