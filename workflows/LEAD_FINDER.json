        [{ "node": "Aggregate All Results", "type": "main", "index": 0 }]
      ]
    },
    "Aggregate All Results": {
      "main": [
        [{ "node": "Deduplicate Leads", "type": "main", "index": 0 }]
      ]
    },
    "Deduplicate Leads": {
      "main": [
        [{ "node": "Loop Through Leads", "type": "main", "index": 0 }]
      ]
    },
    "Loop Through Leads": {
      "main": [
        [{ "node": "Save to Airtable", "type": "main", "index": 0 }],
        []
      ]
    },
    "Save to Airtable": {
