        [{ "node": "SerpAPI Search", "type": "main", "index": 0 }]
      ]
    },
    "SerpAPI Search": {
      "main": [
        [{ "node": "Parse SERP Results", "type": "main", "index": 0 }]
      ]
    },
    "Parse SERP Results": {
